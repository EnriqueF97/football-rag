# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Names only live here — never put real secrets in .env.example.

# Anthropic API key — used for generation (Phase 4) and the LLM judge (Phase 5).
# Get one at https://console.anthropic.com/ . Format: sk-ant-...
ANTHROPIC_API_KEY=

# Optional: default model id for generation. See docs/commands.md.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Guardian Open Platform key — reliable-tier ingest (`make ingest-guardian`).
# Free key at https://open-platform.theguardian.com/access/ .
GUARDIAN_API_KEY=

# Media Cloud API token — reliable-tier discovery for BBC/Sky/ESPN
# (`make ingest-mediacloud`). Free: https://search.mediacloud.org → account → API token.
MEDIACLOUD_API_KEY=
